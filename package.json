{
  "name": "mtracker",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f server/docker-compose.yml up -d",
    "dev:server": "npm --prefix server run dev",
    "migrate": "npm --prefix server run migrate",
    "prepare": ""
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "vazirmatn": "^33.0.3"
  }
}
