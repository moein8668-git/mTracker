DATABASE_URL=postgres://mtracker:localdev@localhost:5432/mtracker
PORT=8788
CORS_ORIGIN=http://localhost:5189
OTP_PEPPER=dev-pepper-change-me
SESSION_TTL_DAYS=90
SMTP_URL=
MAIL_FROM=mTracker <no-reply@localhost>
DEV_RETURN_OTP=1
# Managed Postgres (Aiven/Neon/RDS): append `&sslrootcert=ca.pem` to DATABASE_URL
# with the provider's CA file saved as server/ca.pem. Local Docker needs neither.
# (Hyperdrive, when used later, takes the bare URL WITHOUT the file ref.)
# Cloudflare mail relay worker (Resend) — preferred once deployed. Needs BOTH set, else SMTP/console.
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
