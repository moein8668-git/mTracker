{
  "name": "mtracker-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "test": "vitest run",
    "smoke": "tsx --env-file=.env scripts/smoke.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "pg": "^8.12.0",
    "zod": "^3.23.0",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "@types/pg": "^8.11.0",
    "@types/nodemailer": "^6.4.15",
    "@types/node": "^20.0.0"
  }
}
