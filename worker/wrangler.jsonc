{
  "name": "mtracker-mail",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "vars": {
    // Must be an address on your Resend-verified domain.
    // Dashboard: Workers & Pages → mtracker-mail → Settings → Variables.
    "MAIL_FROM": "mTracker <login@mail.yourdomain.com>"
  }
  // Secrets — Dashboard → Settings → Secrets and variables → Secrets (never in code):
  //   RESEND_API_KEY    — Resend API key (re_...).
  //   MAIL_RELAY_SECRET — long random string; must match the API server's MAIL_RELAY_SECRET.
  // Hyperdrive (NOT used by this worker) — for the later full API port:
  //   Workers & Pages → Hyperdrive → Create, paste the Aiven URL WITHOUT any
  //   file ref (`...?sslmode=require`, no `sslrootcert=` — Hyperdrive manages TLS
  //   itself), and reference its binding + id from the API worker's config then.
}
