{
  "name": "mtracker",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "MAIL_FROM": "mTracker <login@e.moein8668.xyz>",
    "MAIL_SIGNING_KEY_ID": "2026-09-a"
  },
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "MAIN_MAIL",
      "service": "main-mail"
    }
  ]
  //
  // Bindings — Settings → Bindings → Add → Hyperdrive:
  //   binding name HYPERDRIVE, attached to your Aiven Hyperdrive config.
  //   (Create the config first at Workers & Pages → Hyperdrive, using the
  //   bare Aiven URL: ...?sslmode=require with NO sslrootcert file ref.)
  //
  // Variables — Settings → Variables:
  //   MAIN_MAIL uses the internal Service binding above; production does not
  //   configure a public relay URL. CORS_ORIGIN is optional when the browser
  //   and API share the same custom domain.
  //
  // Secrets — Settings → Secrets and variables → Secrets:
  //   API_SECRET     — same value as the mail relay's API_SECRET.
  //   OTP_PEPPER     — MUST equal the Node API's OTP_PEPPER while both share
  //                    the Aiven DB (codes are peppered hashes). Rotate both
  //                    together or cross-issued codes stop verifying.
}
